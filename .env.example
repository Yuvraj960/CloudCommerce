# CloudCommerce — Environment Variables Template
# Copy to .env for local development (git-ignored)

# Service name shown in logs
SERVICE_NAME=auth-service

# Node environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# ---- Auth Service ----
DATABASE_URL=postgresql://cloudcommerce:cloudcommerce@localhost:5432/cloudcommerce
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---- Product Service ----
MONGODB_URI=mongodb://localhost:27017/cloudcommerce
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=cloudcommerce-images

# ---- Cart Service ----
REDIS_URL=redis://localhost:6379

# ---- Kafka ----
KAFKA_BROKER=localhost:9092

# ---- All services ----
PORT=3001