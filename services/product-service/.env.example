# Product Service

SERVICE_NAME=product-service
NODE_ENV=development
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cloudcommerce

# JWT (same secret as auth-service — needed to verify tokens)
JWT_SECRET=change-me-in-production-min-32-chars-long

# S3 / LocalStack
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=cloudcommerce-images

PORT=3002